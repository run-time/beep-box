{
  "name": "beep-box",
  "version": "0.0.1",
  "description": "An open source chiptune player",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node scripts/build-vercel.mjs",
    "lint": "eslint src server.js --ext .js --ignore-pattern src/vendor/ua-parser.js",
    "lint:fix": "eslint src server.js --ext .js --ignore-pattern src/vendor/ua-parser.js --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "verify": "npm run lint && npm run format"
  },
  "devDependencies": {
    "eslint": "^10.3.0",
    "prettier": "^3.8.3"
  },
  "dependencies": {
    "ua-parser-js": "^2.0.10"
  }
}
